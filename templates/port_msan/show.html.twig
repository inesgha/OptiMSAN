{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Port MSAN n°{{ port_m_s_a_n.numeroPort }}{% endblock %}

{% block content %}
    <div class="om-narrow">
        {% set actions %}
            <a href="{{ path('app_port_m_s_a_n_edit', {'id': port_m_s_a_n.id}) }}" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Modifier</a>
        {% endset %}
        {% set sousTitre %}{{ ui.badge('port', port_m_s_a_n.etatPort) }}{% endset %}
        {{ ui.page_header('Port n°' ~ port_m_s_a_n.numeroPort, {
            back_url: path('app_port_m_s_a_n_index'),
            back_label: 'Ports',
            eyebrow: 'Port MSAN',
            icon: 'ethernet',
            subtitle: sousTitre,
            actions: actions,
        }) }}

        {% set carte = port_m_s_a_n.slotCard %}
        <section class="om-card">
            <div class="om-card__body">
                <dl class="om-dl">
                    <dt>Identifiant</dt><dd><code>{{ port_m_s_a_n.id }}</code></dd>
                    <dt>Numéro de port</dt><dd>{{ port_m_s_a_n.numeroPort }}</dd>
                    <dt>Type de port</dt><dd><span class="om-tag">{{ port_m_s_a_n.typePort }}</span></dd>
                    <dt>État</dt><dd>{{ ui.badge('port', port_m_s_a_n.etatPort) }}</dd>
                    <dt>Date d'affectation</dt><dd class="om-mono">{{ port_m_s_a_n.dateAffectation ? port_m_s_a_n.dateAffectation|date('d/m/Y') : '—' }}</dd>
                    <dt>Carte</dt>
                    <dd>
                        {% if carte %}
                            <a href="{{ path('app_slot_card_show', {'id': carte.id}) }}">Slot n°{{ carte.numeroSlot }}</a>
                            <span class="om-cell-sub">{{ carte.shelf.siteMSAN.nomSite ?? 'Site ?' }} · Shelf n°{{ carte.shelf.numeroShelf ?? '?' }}</span>
                        {% else %}—{% endif %}
                    </dd>
                </dl>
            </div>
        </section>

        {{ include('port_msan/_delete_form.html.twig') }}
    </div>
{% endblock %}
