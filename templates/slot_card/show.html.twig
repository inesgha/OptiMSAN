{% extends 'base.html.twig' %}

{% block title %}SlotCard {{ slot_card.numeroSlot }}{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('app_slot_card_index') }}">← SlotCards</a>
</nav>

<div class="container mt-4" style="max-width: 600px;">
    <h1 class="mb-4">SlotCard n°{{ slot_card.numeroSlot }}</h1>

    <table class="table table-bordered">
        <tbody>
            <tr><th style="width: 220px;">ID</th><td><code>{{ slot_card.id }}</code></td></tr>
            <tr><th>Numéro Slot</th><td>{{ slot_card.numeroSlot }}</td></tr>
            <tr><th>Type de carte</th><td><span class="badge bg-info text-dark">{{ slot_card.typeCarte }}</span></td></tr>
            <tr><th>Nombre de ports</th><td>{{ slot_card.nombrePortsTotal }}</td></tr>
            <tr><th>Shelf</th><td>{{ slot_card.shelf ? 'Shelf n°' ~ slot_card.shelf.numeroShelf : '—' }}</td></tr>
        </tbody>
    </table>

    <a href="{{ path('app_slot_card_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
    <a href="{{ path('app_slot_card_edit', {'id': slot_card.id}) }}" class="btn btn-primary">Modifier</a>

    {{ include('slot_card/_delete_form.html.twig') }}
</div>
{% endblock %}