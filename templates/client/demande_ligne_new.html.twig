{% extends 'layout/client.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Demande de ligne{% endblock %}

{% block content %}
    <div class="om-narrow">
        {{ ui.page_header('Demander une nouvelle ligne', {
            back_url: path('client_demandes_ligne'),
            back_label: 'Mes demandes de ligne',
            subtitle: 'Choisissez votre offre et indiquez précisément le lieu d\'installation.',
        }) }}

        {{ form_start(form) }}
            <section class="om-card">
                <div class="om-card__body">
                    {{ form_errors(form) }}
                    {{ form_row(form.typeOffre) }}
                    {{ form_row(form.adresseInstallation, {'help': 'Entre 5 et 150 caractères.'}) }}

                    {# Champs cachés remplis par la carte (id utilisés par _map_picker) #}
                    {{ form_widget(form.latitude, {'id': 'demande_lat'}) }}
                    {{ form_widget(form.longitude, {'id': 'demande_lng'}) }}
                    {% include '_map_picker.html.twig' with {
                        mapId: 'demandeMap',
                        latFieldId: 'demande_lat',
                        lngFieldId: 'demande_lng',
                        label: 'Emplacement de l\'installation'
                    } %}
                    {{ include('_ui/_erreurs_position.html.twig', {latitude: form.latitude, longitude: form.longitude}) }}
                </div>
                <div class="om-card__footer">
                    <a href="{{ path('client_demandes_ligne') }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send" aria-hidden="true"></i>Envoyer la demande</button>
                </div>
            </section>
        {{ form_end(form) }}
    </div>
{% endblock %}
