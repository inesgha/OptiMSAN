{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Site MSAN — {{ site_m_s_a_n.nomSite }}{% endblock %}

{% block content %}
    {% set actions %}
        <a href="{{ path('app_site_m_s_a_n_edit', {'id': site_m_s_a_n.id}) }}" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Modifier</a>
    {% endset %}
    {{ ui.page_header(site_m_s_a_n.nomSite, {
        back_url: path('app_site_m_s_a_n_index'),
        back_label: 'Sites MSAN',
        eyebrow: 'Site MSAN',
        icon: 'building',
        actions: actions,
    }) }}

    <div class="row g-4">
        <div class="col-lg-6">
            <section class="om-card h-100" aria-labelledby="titre-fiche">
                <div class="om-card__header">
                    <h2 class="om-card__title" id="titre-fiche"><i class="bi bi-card-text" aria-hidden="true"></i>Fiche du site</h2>
                </div>
                <div class="om-card__body">
                    <dl class="om-dl">
                        <dt>Identifiant</dt><dd><code>{{ site_m_s_a_n.id }}</code></dd>
                        <dt>Nom du site</dt><dd>{{ site_m_s_a_n.nomSite }}</dd>
                        <dt>Adresse IP</dt><dd><code>{{ site_m_s_a_n.adresseIp }}</code></dd>
                        <dt>Type de MSAN</dt><dd><span class="om-tag">{{ site_m_s_a_n.typeMSAN }}</span></dd>
                        <dt>Constructeur</dt><dd>{{ site_m_s_a_n.constructeur }}</dd>
                        <dt>Zone</dt><dd>{{ site_m_s_a_n.zone ? site_m_s_a_n.zone.nomZone : '—' }}</dd>
                        <dt>Coordonnées</dt><dd class="om-mono">{{ site_m_s_a_n.latitude }}, {{ site_m_s_a_n.longitude }}</dd>
                    </dl>
                </div>
            </section>
        </div>
        <div class="col-lg-6">
            <section class="om-card h-100 d-flex flex-column" aria-labelledby="titre-localisation">
                <div class="om-card__header">
                    <h2 class="om-card__title" id="titre-localisation"><i class="bi bi-geo-alt" aria-hidden="true"></i>Localisation</h2>
                </div>
                <div id="showMap" class="om-map om-map--small flex-grow-1" style="min-height: 320px;" aria-label="Carte de localisation du site"></div>
            </section>
        </div>
    </div>

    <div class="om-narrow">
        {{ include('site_msan/_delete_form.html.twig') }}
    </div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const position = [{{ site_m_s_a_n.latitude }}, {{ site_m_s_a_n.longitude }}];
    const map = L.map('showMap').setView(position, 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);
    L.marker(position, {
        icon: L.divIcon({
            className: 'om-pin-wrap',
            html: '<span class="om-pin om-pin--site"><i class="bi bi-building"></i></span>',
            iconSize: [32, 32],
            iconAnchor: [16, 16],
        }),
    }).addTo(map);
});
</script>
{% endblock %}
