{% extends 'layout/technicien.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Mes tickets{% endblock %}

{% block content %}
    {{ ui.page_header('Mes tickets', {
        eyebrow: 'Mon activité',
        icon: 'ticket-detailed',
        subtitle: 'Tickets qui vous sont assignés. Mettez-les à jour au fil de votre intervention.',
    }) }}

    <section class="om-card" data-controller="table-filter" aria-label="Mes tickets assignés">
        {% if reclamations is empty %}
            {{ ui.empty_state('Aucun ticket assigné pour le moment', 'Un administrateur vous assignera les prochaines interventions.', 'ticket-detailed') }}
        {% else %}
            {{ ui.toolbar('Rechercher un ticket, un client, une panne…', constant('App\\Service\\ReclamationWorkflow::LIBELLES')) }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Ticket</th>
                            <th scope="col">Client</th>
                            <th scope="col">Type de panne</th>
                            <th scope="col">Priorité</th>
                            <th scope="col">État</th>
                            <th scope="col" class="om-col-actions"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reclamation in reclamations %}
                            <tr data-table-filter-target="row" data-etat="{{ reclamation.etatTicket }}">
                                <td>
                                    <code>{{ reclamation.codeTicket }}</code>
                                    <span class="om-cell-sub">{{ reclamation.dateCreation|date('d/m/Y H:i') }}</span>
                                </td>
                                <td class="text-nowrap">{{ ui.personne(reclamation.client) }}</td>
                                <td>{{ reclamation.typePanne|libelle('panne') }}</td>
                                <td>{{ ui.badge('priorite', reclamation.priorite) }}</td>
                                <td>{{ ui.badge('ticket', reclamation.etatTicket) }}</td>
                                <td class="om-col-actions">
                                    <a href="{{ path('technicien_ticket_update', {'id': reclamation.id}) }}" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>Mettre à jour<span class="visually-hidden"> le ticket {{ reclamation.codeTicket }}</span>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(6) }}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
