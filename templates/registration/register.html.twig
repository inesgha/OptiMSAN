{% extends 'layout/auth.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block form_class %} om-auth__form--wide{% endblock %}

{% block auth %}
    <h1 class="om-auth__title">Créer un compte client</h1>
    <p class="om-auth__intro">
        Suivez vos réclamations et vos demandes de ligne en ligne. Les champs marqués d'un
        <span class="text-danger">*</span> sont obligatoires.
    </p>

    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_errors(registrationForm) }}

        <div class="row gx-3">
            <div class="col-sm-6">{{ form_row(registrationForm.nom, {'attr': {'autocomplete': 'family-name'}}) }}</div>
            <div class="col-sm-6">{{ form_row(registrationForm.prenom, {'attr': {'autocomplete': 'given-name'}}) }}</div>
        </div>

        {{ form_row(registrationForm.email, {'attr': {'autocomplete': 'email', 'placeholder': 'prenom.nom@exemple.tn'}}) }}

        <div class="row gx-3">
            <div class="col-sm-6">{{ form_row(registrationForm.telephone, {'attr': {'autocomplete': 'tel', 'inputmode': 'numeric', 'placeholder': '20123456'}}) }}</div>
            <div class="col-sm-6">{{ form_row(registrationForm.cin, {'attr': {'inputmode': 'numeric', 'placeholder': '01234567'}}) }}</div>
        </div>

        {{ form_row(registrationForm.adresse, {'attr': {'autocomplete': 'street-address'}}) }}
        {{ form_row(registrationForm.plainPassword, {'help': 'Au moins 6 caractères.'}) }}

        <button type="submit" class="btn btn-primary btn-lg w-100 mt-2">
            <i class="bi bi-person-check" aria-hidden="true"></i>Créer mon compte
        </button>
    {{ form_end(registrationForm) }}

    <p class="text-center mt-4 mb-0 om-muted">
        Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
    </p>
{% endblock %}
