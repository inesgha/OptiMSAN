{% extends 'base.html.twig' %}

{% block title %}Mes réclamations{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand" href="{{ path('client_dashboard') }}">← OptiMSAN Client</a>
</nav>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes réclamations</h1>
        <a href="{{ path('client_reclamation_new') }}" class="btn btn-primary">+ Nouvelle réclamation</a>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Ticket</th>
                <th>Type</th>
                <th>Priorité</th>
                <th>État</th>
                <th>Date création</th>
            </tr>
        </thead>
        <tbody>
        {% for reclamation in reclamations %}
            <tr>
                <td><code>{{ reclamation.codeTicket }}</code></td>
                <td>{{ reclamation.typePanne }}</td>
                <td>
                    <span class="badge bg-{{ reclamation.priorite == 'urgente' ? 'danger' : (reclamation.priorite == 'normale' ? 'warning' : 'secondary') }}">
                        {{ reclamation.priorite }}
                    </span>
                </td>
                <td>
                    <span class="badge bg-{{ reclamation.etatTicket == 'ouvert' ? 'info' : 'success' }}">
                        {{ reclamation.etatTicket }}
                    </span>
                </td>
                <td>{{ reclamation.dateCreation ? reclamation.dateCreation|date('d/m/Y H:i') : '' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">Aucune réclamation pour le moment</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}