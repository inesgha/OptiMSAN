{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}SlotCards{% endblock %}

{% block content %}
    {% set actions %}
        <a href="{{ path('app_slot_card_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Ajouter une carte</a>
    {% endset %}
    {{ ui.page_header('Cartes', {
        eyebrow: 'Inventaire réseau',
        icon: 'cpu',
        subtitle: 'Cartes (SlotCards) insérées dans les shelves. L\'ID sert de référence dans l\'import Excel.',
        actions: actions,
    }) }}
    {{ ui.hierarchie('carte') }}

    <section class="om-card" data-controller="table-filter" aria-label="Liste des cartes">
        {% if slot_cards is empty %}
            {{ ui.empty_state('Aucune carte enregistrée', 'Insérez une carte dans un shelf pour pouvoir déclarer ses ports.', 'cpu', path('app_slot_card_new'), 'Ajouter une carte') }}
        {% else %}
            {{ ui.toolbar('Rechercher un type, un site…') }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Carte</th>
                            <th scope="col">Type</th>
                            <th scope="col">Emplacement</th>
                            <th scope="col" class="om-col-num">Ports</th>
                            <th scope="col" class="om-col-actions"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for slot_card in slot_cards %}
                            <tr data-table-filter-target="row">
                                <td><code>{{ slot_card.id }}</code></td>
                                <td class="om-cell-main">Slot n°{{ slot_card.numeroSlot }}</td>
                                <td><span class="om-tag">{{ slot_card.typeCarte }}</span></td>
                                <td>
                                    {% if slot_card.shelf %}
                                        {{ slot_card.shelf.siteMSAN ? slot_card.shelf.siteMSAN.nomSite : 'Site ?' }}
                                        <span class="om-cell-sub">Shelf n°{{ slot_card.shelf.numeroShelf }}</span>
                                    {% else %}—{% endif %}
                                </td>
                                <td class="om-col-num">{{ slot_card.nombrePortsTotal }}</td>
                                <td class="om-col-actions">
                                    <a href="{{ path('app_slot_card_show', {'id': slot_card.id}) }}" class="btn btn-ghost btn-sm"><i class="bi bi-eye" aria-hidden="true"></i>Voir<span class="visually-hidden"> la carte {{ slot_card.id }}</span></a>
                                    <a href="{{ path('app_slot_card_edit', {'id': slot_card.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil" aria-hidden="true"></i>Modifier<span class="visually-hidden"> la carte {{ slot_card.id }}</span></a>
                                </td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(6) }}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
