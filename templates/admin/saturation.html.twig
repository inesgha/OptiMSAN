{% extends 'base.html.twig' %}

{% block title %}Dashboard de saturation{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('admin_dashboard') }}">← OptiMSAN Admin</a>
</nav>

<div class="container mt-4">
    <h1 class="mb-4">Dashboard de saturation réseau</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-primary text-center">
                <div class="card-body">
                    <h6 class="text-muted">Ports totaux</h6>
                    <h2>{{ totalPorts }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-danger text-center">
                <div class="card-body">
                    <h6 class="text-muted">Ports occupés</h6>
                    <h2>{{ totalOccupes }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-{{ tauxGlobal >= 80 ? 'danger' : (tauxGlobal >= 50 ? 'warning' : 'success') }} text-center">
                <div class="card-body">
                    <h6 class="text-muted">Taux de saturation global</h6>
                    <h2>{{ tauxGlobal }}%</h2>
                </div>
            </div>
        </div>
    </div>

    <canvas id="saturationChart" height="100"></canvas>

    <table class="table table-striped table-hover align-middle mt-5">
        <thead class="table-dark">
            <tr>
                <th>Site MSAN</th>
                <th>Type</th>
                <th>Total ports</th>
                <th>Occupés</th>
                <th>Libres</th>
                <th>En panne</th>
                <th>Taux de saturation</th>
            </tr>
        </thead>
        <tbody>
        {% for site in sites %}
            {% set taux = site.total_ports > 0 ? (site.ports_occupes / site.total_ports * 100)|round(1) : 0 %}
            <tr>
                <td>{{ site.nom_site }}</td>
                <td><span class="badge bg-info text-dark">{{ site.type_msan }}</span></td>
                <td>{{ site.total_ports }}</td>
                <td>{{ site.ports_occupes }}</td>
                <td>{{ site.ports_libres }}</td>
                <td>{{ site.ports_en_panne }}</td>
                <td>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar bg-{{ taux >= 80 ? 'danger' : (taux >= 50 ? 'warning' : 'success') }}"
                             style="width: {{ taux }}%;">
                            {{ taux }}%
                        </div>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Aucun site enregistré</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    const ctx = document.getElementById('saturationChart');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: [{% for site in sites %}'{{ site.nom_site|escape('js') }}',{% endfor %}],
            datasets: [
                {
                    label: 'Ports occupés',
                    data: [{% for site in sites %}{{ site.ports_occupes }},{% endfor %}],
                    backgroundColor: '#dc3545',
                },
                {
                    label: 'Ports libres',
                    data: [{% for site in sites %}{{ site.ports_libres }},{% endfor %}],
                    backgroundColor: '#198754',
                },
            ],
        },
        options: {
            responsive: true,
            scales: {
                x: { stacked: true },
                y: { stacked: true, beginAtZero: true },
            },
        },
    });
</script>
{% endblock %}