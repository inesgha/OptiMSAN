{# Messages flash affichés en toasts en haut à droite sur toutes les pages.
   Succès et informations disparaissent seuls après 6 s ; erreurs et avertissements restent jusqu'à fermeture. #}
{% set tons = {'success': 'success', 'error': 'danger', 'danger': 'danger', 'warning': 'warning', 'info': 'info'} %}
{% set icones = {'success': 'check-circle-fill', 'danger': 'x-octagon-fill', 'warning': 'exclamation-triangle-fill', 'info': 'info-circle-fill'} %}
{% set titres = {'success': 'Opération réussie', 'danger': 'Erreur', 'warning': 'Attention', 'info': 'Information'} %}
{% set flashes = app.flashes %}
{% if flashes is not empty %}
    <div id="flash-messages" class="om-toasts">
        {% for type, messages in flashes %}
            {% set ton = tons[type] ?? 'info' %}
            {% for message in messages %}
                <div class="toast om-toast om-toast--{{ ton }} show"
                     role="{{ ton in ['danger', 'warning'] ? 'alert' : 'status' }}" aria-atomic="true"
                     data-flash-type="{{ type }}"
                     data-controller="toast"
                     data-toast-delai-value="{{ ton in ['danger', 'warning'] ? 0 : 6000 }}">
                    <i class="bi bi-{{ icones[ton] }} om-toast__icon" aria-hidden="true"></i>
                    <div class="om-toast__body">
                        <strong class="om-toast__title">{{ titres[ton] }}</strong>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Fermer le message"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
