{# Sélecteur de position sur carte.
   Variables : mapId, latFieldId, lngFieldId (id des champs à remplir), defaultLat, defaultLng, label (facultatifs) #}
<div class="mb-3">
    <span class="form-label d-block" id="{{ mapId }}-label">{{ label|default('Position sur la carte') }}</span>
    <div id="{{ mapId }}" class="om-map om-map--picker" aria-labelledby="{{ mapId }}-label" aria-describedby="{{ mapId }}-aide"></div>
    <div class="form-text d-flex flex-wrap justify-content-between gap-2" id="{{ mapId }}-aide">
        <span><i class="bi bi-cursor me-1" aria-hidden="true"></i>Cliquez sur la carte ou faites glisser le repère pour placer le point.</span>
        <span class="om-mono" id="{{ mapId }}-coords" aria-live="polite"></span>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const latInput = document.getElementById('{{ latFieldId }}');
    const lngInput = document.getElementById('{{ lngFieldId }}');
    const coords = document.getElementById('{{ mapId }}-coords');
    // Les champs numériques en français utilisent la virgule décimale (36,8065)
    const nombre = (champ) => parseFloat(String(champ.value).replace(',', '.'));

    const initialLat = nombre(latInput) || {{ defaultLat|default(36.8065) }};
    const initialLng = nombre(lngInput) || {{ defaultLng|default(10.1815) }};

    const map = L.map('{{ mapId }}').setView([initialLat, initialLng], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    const icone = L.divIcon({
        className: 'om-pin-wrap',
        html: '<span class="om-pin om-pin--moi"><i class="bi bi-geo-alt-fill"></i></span>',
        iconSize: [32, 32],
        iconAnchor: [16, 16],
    });

    let marker = L.marker([initialLat, initialLng], { draggable: true, icon: icone }).addTo(map);

    function afficher() {
        coords.textContent = latInput.value && lngInput.value
            ? nombre(latInput).toFixed(5) + ', ' + nombre(lngInput).toFixed(5)
            : 'Aucun point choisi';
    }

    function updateFields(lat, lng) {
        latInput.value = lat.toFixed(6);
        lngInput.value = lng.toFixed(6);
        afficher();
    }

    marker.on('dragend', function () {
        const pos = marker.getLatLng();
        updateFields(pos.lat, pos.lng);
    });

    map.on('click', function (e) {
        marker.setLatLng(e.latlng);
        updateFields(e.latlng.lat, e.latlng.lng);
    });

    // Saisie manuelle ou bouton « ma position » : le repère suit les champs
    [latInput, lngInput].forEach(function (champ) {
        champ.addEventListener('change', function () {
            const lat = nombre(latInput);
            const lng = nombre(lngInput);
            if (!isNaN(lat) && !isNaN(lng)) {
                marker.setLatLng([lat, lng]);
                map.setView([lat, lng], Math.max(map.getZoom(), 14));
            }
            afficher();
        });
    });

    afficher();

    if (!latInput.value || !lngInput.value) {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                map.setView([lat, lng], 15);
                marker.setLatLng([lat, lng]);
                updateFields(lat, lng);
            });
        }
    }
});
</script>
