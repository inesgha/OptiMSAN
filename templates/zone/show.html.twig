{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Zone {{ zone.nomZone }}{% endblock %}

{% block content %}
    <div class="om-narrow">
        {% set actions %}
            <a href="{{ path('app_zone_edit', {'id': zone.id}) }}" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Modifier</a>
        {% endset %}
        {{ ui.page_header(zone.nomZone, {
            back_url: path('app_zone_index'),
            back_label: 'Zones',
            eyebrow: 'Zone',
            icon: 'map',
            actions: actions,
        }) }}

        <section class="om-card">
            <div class="om-card__body">
                <dl class="om-dl">
                    <dt>Identifiant</dt><dd><code>{{ zone.id }}</code></dd>
                    <dt>Nom de la zone</dt><dd>{{ zone.nomZone }}</dd>
                    <dt>Code postal</dt><dd class="om-mono">{{ zone.codePostal }}</dd>
                </dl>
            </div>
        </section>

        {{ include('zone/_delete_form.html.twig') }}
    </div>
{% endblock %}
