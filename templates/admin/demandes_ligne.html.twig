{% extends 'base.html.twig' %}

{% block title %}Demandes de ligne{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('admin_dashboard') }}">← OptiMSAN Admin</a>
</nav>

<div class="container mt-4">
    <h1 class="mb-4">Demandes de ligne</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Référence</th>
                <th>Client</th>
                <th>Offre</th>
                <th>Adresse</th>
                <th>Port affecté</th>
                <th>État</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for demande in demandes %}
            <tr>
                <td><code>{{ demande.codeDemande }}</code></td>
                <td>{{ demande.client ? demande.client.prenom ~ ' ' ~ demande.client.nom : '—' }}</td>
                <td>{{ demande.typeOffre }}</td>
                <td>{{ demande.adresseInstallation }}</td>
                <td>
                    {% if demande.portMSAN %}
                        Port {{ demande.portMSAN.numeroPort }}
                    {% else %}
                        <span class="text-muted">Non affecté</span>
                    {% endif %}
                </td>
                <td>
                    <span class="badge bg-{{ demande.etatDemande == 'en_attente' ? 'warning' : (demande.etatDemande == 'refusee' ? 'danger' : 'success') }}">
                        {{ demande.etatDemande }}
                    </span>
                </td>
                <td>{{ demande.dateDemande ? demande.dateDemande|date('d/m/Y H:i') : '' }}</td>
                <td>
                    <a href="{{ path('admin_demande_ligne_assign', {'id': demande.id}) }}" class="btn btn-sm btn-primary">Gérer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center text-muted py-4">Aucune demande pour le moment</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}