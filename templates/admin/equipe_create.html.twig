{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}{{ titre }}{% endblock %}

{% block content %}
    <div class="om-narrow">
        {{ ui.page_header(titre, {
            back_url: path('admin_equipe'),
            back_label: 'Équipe',
            subtitle: 'Le compte est actif immédiatement ; transmettez le mot de passe à la personne concernée.',
        }) }}

        {{ form_start(form) }}
            <section class="om-card">
                <div class="om-card__body">
                    {{ form_errors(form) }}

                    <h2 class="om-section-title">Identité</h2>
                    <div class="row gx-3">
                        <div class="col-md-6">{{ form_row(form.nom, {'label': 'Nom'}) }}</div>
                        <div class="col-md-6">{{ form_row(form.prenom, {'label': 'Prénom'}) }}</div>
                    </div>
                    <div class="row gx-3">
                        <div class="col-md-6">{{ form_row(form.email, {'label': 'Adresse e-mail'}) }}</div>
                        <div class="col-md-6">{{ form_row(form.telephone, {'label': 'Téléphone (facultatif, 8 chiffres)'}) }}</div>
                    </div>

                    {% if form.matricule is defined %}
                        <h2 class="om-section-title mt-3">Terrain</h2>
                        {{ form_row(form.matricule, {'label': 'Matricule'}) }}
                        <div class="row gx-3">
                            <div class="col-md-6">{{ form_row(form.latitudeActuelle) }}</div>
                            <div class="col-md-6">{{ form_row(form.longitudeActuelle) }}</div>
                        </div>
                    {% endif %}

                    {% if form.niveauAcces is defined %}
                        <h2 class="om-section-title mt-3">Droits</h2>
                        {{ form_row(form.niveauAcces, {'label': 'Niveau d\'accès'}) }}
                    {% endif %}

                    <h2 class="om-section-title mt-3">Connexion</h2>
                    {{ form_row(form.plainPassword, {'label': 'Mot de passe', 'help': 'Au moins 6 caractères.', 'attr': {'autocomplete': 'new-password'}}) }}
                </div>
                <div class="om-card__footer">
                    <a href="{{ path('admin_equipe') }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-person-check" aria-hidden="true"></i>Créer le compte</button>
                </div>
            </section>
        {{ form_end(form) }}
    </div>
{% endblock %}
