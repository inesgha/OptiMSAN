{# Zone de suppression d'un élément d'inventaire.
   Variables : action (URL), token (identifiant CSRF), titre, texte, confirmation #}
<div class="om-danger-zone">
    <div>
        <p class="om-danger-zone__title">{{ titre }}</p>
        <p class="om-danger-zone__text">{{ texte }}</p>
    </div>
    <form method="post" action="{{ action }}" onsubmit="return confirm('{{ confirmation|e('js') }}');">
        <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
        <button class="btn btn-outline-danger"><i class="bi bi-trash3" aria-hidden="true"></i>Supprimer</button>
    </form>
</div>
