{% extends 'layout/auth.html.twig' %}

{% block title %}E-mail envoyé — OptiMSAN{% endblock %}

{% block auth %}
    <span class="om-icon-tile om-icon-tile--accent mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
        <i class="bi bi-envelope-check" aria-hidden="true"></i>
    </span>
    <h1 class="om-auth__title">Vérifiez vos e-mails</h1>
    <p class="om-auth__intro">
        Si un compte correspond à cette adresse, un lien de réinitialisation
        vient de vous être envoyé. Ce lien expire dans
        {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    </p>

    <p class="om-muted">
        Vous n'avez rien reçu ? Vérifiez vos courriers indésirables ou
        <a href="{{ path('app_forgot_password_request') }}">réessayez</a>.
    </p>

    <a href="{{ path('app_login') }}" class="btn btn-outline-secondary w-100 mt-3">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>Retour à la connexion
    </a>
{% endblock %}
