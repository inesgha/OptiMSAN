{% extends 'base.html.twig' %}

{% block title %}Shelves{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('admin_dashboard') }}">← OptiMSAN Admin</a>
</nav>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Shelves</h1>
        <a href="{{ path('app_shelf_new') }}" class="btn btn-primary">+ Ajouter un Shelf</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Numéro Shelf</th>
                <th>Adresse IP Sub</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for shelf in shelves %}
            <tr>
                <td><code>{{ shelf.id }}</code></td>
                <td>{{ shelf.numeroShelf }}</td>
                <td><code>{{ shelf.adresseIpSub }}</code></td>
                <td>
                    <a href="{{ path('app_shelf_show', {'id': shelf.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                    <a href="{{ path('app_shelf_edit', {'id': shelf.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center text-muted py-4">Aucun Shelf enregistré</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}