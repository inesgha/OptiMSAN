{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Réclamations{% endblock %}

{% block content %}
    {{ ui.page_header('Tickets', {
        eyebrow: 'Exploitation',
        icon: 'ticket-detailed',
        subtitle: 'Réclamations déposées par les clients : assignez un technicien et suivez leur résolution.',
    }) }}

    <section class="om-card" data-controller="table-filter" aria-label="Liste des tickets">
        {% if reclamations is empty %}
            {{ ui.empty_state('Aucune réclamation pour le moment', 'Les tickets déposés par les clients apparaîtront ici.', 'ticket-detailed') }}
        {% else %}
            {{ ui.toolbar('Rechercher un ticket, un client, une panne…', constant('App\\Service\\ReclamationWorkflow::LIBELLES')) }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Ticket</th>
                            <th scope="col">Client</th>
                            <th scope="col">Type de panne</th>
                            <th scope="col">Priorité</th>
                            <th scope="col">Technicien</th>
                            <th scope="col">État</th>
                            <th scope="col" class="om-col-actions"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reclamation in reclamations %}
                            <tr data-table-filter-target="row" data-etat="{{ reclamation.etatTicket }}">
                                <td>
                                    <code>{{ reclamation.codeTicket }}</code>
                                    <span class="om-cell-sub">{{ reclamation.dateCreation ? reclamation.dateCreation|date('d/m/Y H:i') }}</span>
                                </td>
                                <td class="text-nowrap">{{ ui.personne(reclamation.client) }}</td>
                                <td>{{ reclamation.typePanne|libelle('panne') }}</td>
                                <td>{{ ui.badge('priorite', reclamation.priorite) }}</td>
                                <td class="text-nowrap">
                                    {% if reclamation.technicien %}
                                        {{ reclamation.technicien.prenom }} {{ reclamation.technicien.nom }}
                                    {% else %}
                                        <span class="om-muted"><i class="bi bi-person-dash me-1" aria-hidden="true"></i>Non assigné</span>
                                    {% endif %}
                                </td>
                                <td>{{ ui.badge('ticket', reclamation.etatTicket) }}</td>
                                <td class="om-col-actions">
                                    <a href="{{ path('admin_reclamation_assign', {'id': reclamation.id}) }}" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-sliders" aria-hidden="true"></i>Gérer<span class="visually-hidden"> le ticket {{ reclamation.codeTicket }}</span>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(7) }}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
