{% extends 'base.html.twig' %}

{% block title %}Déposer une réclamation{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand" href="{{ path('client_dashboard') }}">← OptiMSAN Client</a>
</nav>

<div class="container mt-4" style="max-width: 700px;">
    <h1 class="mb-4">Déposer une réclamation</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="mb-3">
            {{ form_label(form.typePanne) }}
            {{ form_widget(form.typePanne, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.typePanne) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.description) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.priorite) }}
            {{ form_widget(form.priorite, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.priorite) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.portMSAN) }}
            {{ form_widget(form.portMSAN, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.portMSAN) }}
        </div>

        <button type="submit" class="btn btn-primary">Envoyer la réclamation</button>
    {{ form_end(form) }}
</div>
{% endblock %}