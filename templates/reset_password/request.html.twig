{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — OptiMSAN{% endblock %}

{% block body %}
<div class="d-flex" style="min-height: 100vh;">
    <!-- Panneau gauche -->
    <div class="d-none d-lg-flex flex-column justify-content-between p-5" style="width: 45%; background-color: #10151F; color: #fff;">
        <div class="d-flex align-items-center">
            <img src="{{ asset('image/logo-tunisie-telecom.jpg') }}" alt="Tunisie Télécom" height="40" class="me-3">
            <span class="fs-4 fw-semibold">OptiMSAN</span>
        </div>

        <div>
            <h2 class="mb-3" style="font-weight: 700; letter-spacing: -0.02em;">
                Le réseau fixe, sous contrôle.
            </h2>
            <p style="color: #A8B0BD; max-width: 420px;">
                Supervision de l'infrastructure MSAN, suivi des pannes et gestion
                des demandes de ligne, en un seul espace.
            </p>
        </div>

        <small style="color: #5B6472;">OptiMSAN — Système de gestion réseau fixe & support technique</small>
    </div>

    <!-- Panneau droit : formulaire -->
    <div class="d-flex align-items-center justify-content-center flex-grow-1 p-4">
        <div style="width: 100%; max-width: 380px;">
            <div class="d-lg-none text-center mb-4">
                <img src="{{ asset('image/logo-tunisie-telecom.jpg') }}" alt="Tunisie Télécom" height="36">
            </div>

            <h1 class="h3 mb-1" style="font-weight: 700;">Mot de passe oublié</h1>
            <p class="text-muted mb-4">
                Indiquez votre adresse e-mail, nous vous enverrons un lien
                pour réinitialiser votre mot de passe.
            </p>

            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
            {% endfor %}

            {{ form_start(requestForm) }}
                <div class="mb-3">
                    {{ form_label(requestForm.email, 'Adresse e-mail', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(requestForm.email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(requestForm.email) }}
                </div>

                <button class="btn btn-primary w-100" type="submit">Envoyer le lien de réinitialisation</button>
            {{ form_end(requestForm) }}

            <p class="text-center mt-4 text-muted">
                <a href="{{ path('app_login') }}">← Retour à la connexion</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}