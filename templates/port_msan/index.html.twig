{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Ports MSAN{% endblock %}

{% block content %}
    {% set actions %}
        <a href="{{ path('admin_import_ports') }}" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>Import / Export</a>
        <a href="{{ path('app_port_m_s_a_n_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Ajouter un port</a>
    {% endset %}
    {{ ui.page_header('Ports', {
        eyebrow: 'Inventaire réseau',
        icon: 'ethernet',
        subtitle: 'Ports des cartes MSAN : un port libre peut être affecté à une demande de ligne.',
        actions: actions,
    }) }}
    {{ ui.hierarchie('port') }}

    <section class="om-card" data-controller="table-filter" aria-label="Liste des ports">
        {% if port_m_s_a_ns is empty %}
            {{ ui.empty_state('Aucun port enregistré', 'Déclarez des ports un par un ou importez-les depuis un fichier Excel.', 'ethernet', path('app_port_m_s_a_n_new'), 'Ajouter un port') }}
        {% else %}
            {{ ui.toolbar('Rechercher un numéro, un type, un site…', {'libre': 'Libre', 'occupe': 'Occupé', 'panne': 'En panne', 'reserve': 'Réservé'}) }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Port</th>
                            <th scope="col">Type</th>
                            <th scope="col">État</th>
                            <th scope="col">Carte</th>
                            <th scope="col">Affecté le</th>
                            <th scope="col" class="om-col-actions"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for port_m_s_a_n in port_m_s_a_ns %}
                            {% set carte = port_m_s_a_n.slotCard %}
                            <tr data-table-filter-target="row" data-etat="{{ port_m_s_a_n.etatPort }}">
                                <td>
                                    <span class="om-cell-main">Port n°{{ port_m_s_a_n.numeroPort }}</span>
                                    <span class="om-cell-sub">ID {{ port_m_s_a_n.id }}</span>
                                </td>
                                <td><span class="om-tag">{{ port_m_s_a_n.typePort }}</span></td>
                                <td>{{ ui.badge('port', port_m_s_a_n.etatPort) }}</td>
                                <td>
                                    {% if carte %}
                                        Slot n°{{ carte.numeroSlot }}
                                        <span class="om-cell-sub">
                                            {{ carte.shelf.siteMSAN.nomSite ?? 'Site ?' }} · Shelf n°{{ carte.shelf.numeroShelf ?? '?' }}
                                        </span>
                                    {% else %}—{% endif %}
                                </td>
                                <td class="om-mono text-nowrap">{{ port_m_s_a_n.dateAffectation ? port_m_s_a_n.dateAffectation|date('d/m/Y') : '—' }}</td>
                                <td class="om-col-actions">
                                    <a href="{{ path('app_port_m_s_a_n_show', {'id': port_m_s_a_n.id}) }}" class="btn btn-ghost btn-sm"><i class="bi bi-eye" aria-hidden="true"></i>Voir<span class="visually-hidden"> le port {{ port_m_s_a_n.numeroPort }}</span></a>
                                    <a href="{{ path('app_port_m_s_a_n_edit', {'id': port_m_s_a_n.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil" aria-hidden="true"></i>Modifier<span class="visually-hidden"> le port {{ port_m_s_a_n.numeroPort }}</span></a>
                                </td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(6) }}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
