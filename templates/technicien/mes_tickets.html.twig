{% extends 'base.html.twig' %}

{% block title %}Mes tickets{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-warning px-3">
    <a class="navbar-brand text-dark" href="{{ path('technicien_dashboard') }}">← OptiMSAN Technicien</a>
</nav>

<div class="container mt-4">
    <h1 class="mb-4">Mes tickets assignés</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Ticket</th>
                <th>Client</th>
                <th>Type</th>
                <th>Priorité</th>
                <th>État</th>
                <th>Créé le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reclamation in reclamations %}
            <tr>
                <td><code>{{ reclamation.codeTicket }}</code></td>
                <td>{{ reclamation.client ? reclamation.client.prenom ~ ' ' ~ reclamation.client.nom : '—' }}</td>
                <td>{{ reclamation.typePanne }}</td>
                <td>
                    <span class="badge bg-{{ reclamation.priorite == 'urgente' ? 'danger' : (reclamation.priorite == 'normale' ? 'warning' : 'secondary') }}">
                        {{ reclamation.priorite }}
                    </span>
                </td>
                <td>
                    <span class="badge bg-{{ reclamation.etatTicket == 'ouvert' ? 'info' : (reclamation.etatTicket == 'resolu' or reclamation.etatTicket == 'ferme' ? 'success' : 'warning') }}">
                        {{ reclamation.etatTicket }}
                    </span>
                </td>
                <td>{{ reclamation.dateCreation|date('d/m/Y H:i') }}</td>
                <td>
                    <a href="{{ path('technicien_ticket_update', {'id': reclamation.id}) }}" class="btn btn-sm btn-primary">Mettre à jour</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Aucun ticket assigné pour le moment</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}