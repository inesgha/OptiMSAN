{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="mb-3">
        {{ form_label(form.numeroPort, 'Numéro Port') }}
        {{ form_widget(form.numeroPort, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.numeroPort) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.typePort, 'Type de port') }}
        {{ form_widget(form.typePort, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.typePort) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.etatPort, 'État du port') }}
        {{ form_widget(form.etatPort, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.etatPort) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.dateAffectation, 'Date d\'affectation') }}
        {{ form_widget(form.dateAffectation, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.dateAffectation) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.slotCard, 'SlotCard') }}
        {{ form_widget(form.slotCard, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.slotCard) }}
    </div>

    <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}