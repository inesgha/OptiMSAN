{% extends 'base.html.twig' %}

{% block title %}Carte réseau{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'technicien_dashboard') }}">
        ← Retour au tableau de bord
    </a>
</nav>

<div class="container-fluid mt-4">
    <h1 class="mb-3">Carte du réseau</h1>

    <div class="mb-3">
        <span class="badge bg-primary">🏢 Sites MSAN ({{ sites|length }})</span>
        <span class="badge bg-warning text-dark">📄 Demandes en attente ({{ demandes|length }})</span>
    </div>

    <div id="carteReseau" style="height: 600px; border-radius: 8px;"></div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const map = L.map('carteReseau').setView([36.8065, 10.1815], 8);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    const iconSite = L.divIcon({
        html: '🏢',
        className: 'emoji-marker',
        iconSize: [30, 30],
    });

    const iconDemande = L.divIcon({
        html: '📄',
        className: 'emoji-marker',
        iconSize: [30, 30],
    });

    const sites = {{ sites|json_encode|raw }};
    const demandes = {{ demandes|json_encode|raw }};

    const tousLesPoints = [];

    sites.forEach(function (site) {
        if (site.latitude && site.longitude) {
            const marker = L.marker([site.latitude, site.longitude], { icon: iconSite }).addTo(map);
            marker.bindPopup(
                '<strong>' + site.nomSite + '</strong><br>' +
                'Type : ' + site.typeMSAN
            );
            tousLesPoints.push([site.latitude, site.longitude]);
        }
    });

    demandes.forEach(function (demande) {
        if (demande.latitude && demande.longitude) {
            const marker = L.marker([demande.latitude, demande.longitude], { icon: iconDemande }).addTo(map);
            marker.bindPopup(
                '<strong>' + demande.codeDemande + '</strong><br>' +
                'Offre : ' + demande.typeOffre + '<br>' +
                demande.adresseInstallation
            );
            tousLesPoints.push([demande.latitude, demande.longitude]);
        }
    });

    if (tousLesPoints.length > 0) {
        map.fitBounds(tousLesPoints, { padding: [50, 50] });
    }
});
</script>

<style>
.emoji-marker {
    font-size: 24px;
    text-align: center;
    background: none;
    border: none;
}
</style>
{% endblock %}