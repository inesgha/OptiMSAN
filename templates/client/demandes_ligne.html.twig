{% extends 'base.html.twig' %}

{% block title %}Mes demandes de ligne{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand" href="{{ path('client_dashboard') }}">← OptiMSAN Client</a>
</nav>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes demandes de ligne</h1>
        <a href="{{ path('client_demande_ligne_new') }}" class="btn btn-primary">+ Nouvelle demande</a>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Référence</th>
                <th>Offre demandée</th>
                <th>Adresse</th>
                <th>État</th>
                <th>Date de la demande</th>
            </tr>
        </thead>
        <tbody>
        {% for demande in demandes %}
            <tr>
                <td><code>{{ demande.codeDemande }}</code></td>
                <td>{{ demande.typeOffre }}</td>
                <td>{{ demande.adresseInstallation }}</td>
                <td>
                    <span class="badge bg-{{ demande.etatDemande == 'en_attente' ? 'warning' : (demande.etatDemande == 'validee' ? 'success' : 'secondary') }}">
                        {{ demande.etatDemande }}
                    </span>
                </td>
                <td>{{ demande.dateDemande ? demande.dateDemande|date('d/m/Y H:i') : '' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">Aucune demande pour le moment</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}