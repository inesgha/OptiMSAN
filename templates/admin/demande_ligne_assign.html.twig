{% extends 'base.html.twig' %}

{% block title %}Gérer la demande {{ demande.codeDemande }}{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('admin_demandes_ligne') }}">← Demandes de ligne</a>
</nav>

<div class="container mt-4" style="max-width: 700px;">
    <h1 class="mb-4">Demande {{ demande.codeDemande }}</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="card mb-4">
        <div class="card-body">
            <p><strong>Client :</strong> {{ demande.client ? demande.client.prenom ~ ' ' ~ demande.client.nom : '—' }}</p>
            <p><strong>Offre demandée :</strong> {{ demande.typeOffre }}</p>
            <p><strong>Adresse d'installation :</strong> {{ demande.adresseInstallation }}</p>
            <p class="mb-0"><strong>Demandé le :</strong> {{ demande.dateDemande|date('d/m/Y H:i') }}</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Tests techniques réalisés</h5>
        <a href="{{ path('admin_demande_ligne_test_new', {'id': demande.id}) }}" class="btn btn-sm btn-outline-primary">+ Nouveau test</a>
    </div>

    {% if tests|length > 0 %}
    <table class="table table-sm table-bordered mb-4">
        <thead>
            <tr>
                <th>Date</th>
                <th>Technicien</th>
                <th>Standard</th>
                <th>Débit ↓/↑</th>
                <th>Qualité</th>
            </tr>
        </thead>
        <tbody>
        {% for test in tests %}
            <tr>
                <td>{{ test.dateTest|date('d/m/Y H:i') }}</td>
                <td>{{ test.technicien.prenom }} {{ test.technicien.nom }}</td>
                <td>{{ test.standard }}</td>
                <td>{{ test.channelRateDown }} / {{ test.channelRateUp }} kbps</td>
                <td>
                    <span class="badge bg-{{ test.qualiteGlobale == 'excellente' or test.qualiteGlobale == 'bonne' ? 'success' : (test.qualiteGlobale == 'moyenne' ? 'warning' : 'danger') }}">
                        {{ test.qualiteGlobale }}
                    </span>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p class="text-muted mb-4">Aucun test réalisé pour le moment.</p>
    {% endif %}

    <hr class="mb-4">

    <h5 class="mb-3">Décision</h5>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="mb-3">
            {{ form_label(form.portMSAN) }}
            {{ form_widget(form.portMSAN, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.portMSAN) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.etatDemande) }}
            {{ form_widget(form.etatDemande, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.etatDemande) }}
            {% include 'demande_ligne/_transitions.html.twig' %}
            <div class="form-text">Seul un port « libre » peut être affecté ; il passe alors à « occupé ». Une demande refusée libère son port.</div>
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}