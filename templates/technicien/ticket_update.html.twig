{% extends 'layout/technicien.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Ticket {{ reclamation.codeTicket }}{% endblock %}

{% block content %}
    {% set sousTitre %}
        {{ ui.badge('ticket', reclamation.etatTicket) }} {{ ui.badge('priorite', reclamation.priorite) }}
        <span class="ms-1">{{ reclamation.typePanne|libelle('panne') }}</span>
    {% endset %}
    {{ ui.page_header('Ticket ' ~ reclamation.codeTicket, {
        back_url: path('technicien_mes_tickets'),
        back_label: 'Mes tickets',
        subtitle: sousTitre,
    }) }}

    <section class="om-card mb-4" aria-label="Cycle de vie du ticket">
        <div class="om-card__body py-4">
            {{ ui.frise_ticket(reclamation) }}
        </div>
    </section>

    <div class="row g-4">
        <div class="col-lg-7">
            {{ include('reclamation/_details.html.twig') }}
        </div>
        <div class="col-lg-5">
            <section class="om-card" aria-labelledby="titre-intervention">
                <div class="om-card__header">
                    <div>
                        <h2 class="om-card__title" id="titre-intervention"><i class="bi bi-tools" aria-hidden="true"></i>Mon intervention</h2>
                        <p class="om-card__subtitle">La description du client est conservée ; vos notes s'ajoutent à part.</p>
                    </div>
                </div>
                {{ form_start(form) }}
                    <div class="om-card__body">
                        {{ form_errors(form) }}
                        {{ form_row(form.etatTicket) }}
                        {% include 'reclamation/_transitions.html.twig' %}
                        <div class="mt-3">
                            {{ form_row(form.notesIntervention, {'help': '1 000 caractères maximum.'}) }}
                        </div>
                    </div>
                    <div class="om-card__footer">
                        <a href="{{ path('technicien_mes_tickets') }}" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Enregistrer</button>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </div>
{% endblock %}
