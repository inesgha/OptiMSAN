{% extends 'base.html.twig' %}

{% block title %}Pannes à proximité{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-warning px-3">
    <a class="navbar-brand text-dark" href="{{ path('technicien_dashboard') }}">← OptiMSAN Technicien</a>
</nav>

<div class="container mt-4">
    <h1 class="mb-2">Pannes à proximité</h1>
    <p class="text-muted mb-4">
        Basé sur votre position actuelle
        ({{ technicien.latitudeActuelle }}, {{ technicien.longitudeActuelle }}) — rayon de 15 km.
    </p>

    {% if not technicien.latitudeActuelle or not technicien.longitudeActuelle %}
        <div class="alert alert-warning">
            Votre position GPS n'est pas renseignée. Contactez un administrateur pour la mettre à jour.
        </div>
    {% endif %}

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Ticket</th>
                <th>Type de panne</th>
                <th>Priorité</th>
                <th>Site MSAN</th>
                <th>Distance</th>
                <th>Créé le</th>
            </tr>
        </thead>
        <tbody>
        {% for panne in pannes %}
            <tr>
                <td><code>{{ panne.code_ticket }}</code></td>
                <td>{{ panne.type_panne }}</td>
                <td>
                    <span class="badge bg-{{ panne.priorite == 'urgente' ? 'danger' : (panne.priorite == 'normale' ? 'warning' : 'secondary') }}">
                        {{ panne.priorite }}
                    </span>
                </td>
                <td>{{ panne.nom_site }}</td>
                <td><strong>{{ panne.distance|number_format(1) }} km</strong></td>
                <td>{{ panne.date_creation|date('d/m/Y H:i') }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted py-4">Aucune panne ouverte à proximité</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}