{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Tester la ligne — {{ demande.codeDemande }}{% endblock %}

{% block content %}
    <div class="om-narrow">
        {{ ui.page_header('Test technique', {
            back_url: path('admin_demande_ligne_assign', {'id': demande.id}),
            back_label: 'Demande ' ~ demande.codeDemande,
            subtitle: 'Enregistrez les mesures relevées sur la ligne avant installation.',
        }) }}

        {{ form_start(form) }}
            <section class="om-card">
                <div class="om-card__body">
                    {{ form_errors(form) }}

                    <h2 class="om-section-title">Contexte</h2>
                    <div class="row gx-3">
                        <div class="col-md-6">{{ form_row(form.technicien) }}</div>
                        <div class="col-md-6">{{ form_row(form.portMSAN) }}</div>
                    </div>
                    {{ form_row(form.standard, {'attr': {'placeholder': 'VDSL2'}}) }}

                    <h2 class="om-section-title mt-3">Débits mesurés</h2>
                    <div class="row gx-3">
                        <div class="col-md-6">{{ form_row(form.channelRateDown) }}</div>
                        <div class="col-md-6">{{ form_row(form.channelRateUp) }}</div>
                    </div>

                    <h2 class="om-section-title mt-3">Qualité du signal</h2>
                    <div class="row gx-3">
                        <div class="col-md-6">{{ form_row(form.snrMarginDown) }}</div>
                        <div class="col-md-6">{{ form_row(form.snrMarginUp) }}</div>
                        <div class="col-md-6">{{ form_row(form.attenuationDown) }}</div>
                        <div class="col-md-6">{{ form_row(form.attenuationUp) }}</div>
                    </div>

                    <h2 class="om-section-title mt-3">Synthèse</h2>
                    <div class="row gx-3">
                        <div class="col-md-6">{{ form_row(form.distanceKm) }}</div>
                        <div class="col-md-6">{{ form_row(form.qualiteGlobale) }}</div>
                    </div>
                </div>
                <div class="om-card__footer">
                    <a href="{{ path('admin_demande_ligne_assign', {'id': demande.id}) }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Enregistrer le test</button>
                </div>
            </section>
        {{ form_end(form) }}
    </div>
{% endblock %}
