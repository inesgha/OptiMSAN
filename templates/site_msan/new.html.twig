{% extends 'base.html.twig' %}

{% block title %}Nouveau Site MSAN{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('app_site_m_s_a_n_index') }}">← Sites MSAN</a>
</nav>

<div class="container mt-4" style="max-width: 700px;">
    <h1 class="mb-4">Nouveau Site MSAN</h1>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="mb-3">{{ form_label(form.nomSite) }}{{ form_widget(form.nomSite, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.nomSite) }}</div>
        <div class="mb-3">{{ form_label(form.adresseIp) }}{{ form_widget(form.adresseIp, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.adresseIp) }}</div>
        <div class="mb-3">{{ form_label(form.typeMSAN) }}{{ form_widget(form.typeMSAN, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.typeMSAN) }}</div>
        <div class="mb-3">{{ form_label(form.constructeur) }}{{ form_widget(form.constructeur, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.constructeur) }}</div>
        <div class="mb-3">{{ form_label(form.zone) }}{{ form_widget(form.zone, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.zone) }}</div>

        {# Champs latitude/longitude cachés, remplis par la carte #}
        <div style="display:none;">
            {{ form_widget(form.latitude, {'id': 'site_lat'}) }}{{ form_errors(form.latitude) }}
            {{ form_widget(form.longitude, {'id': 'site_lng'}) }}{{ form_errors(form.longitude) }}
        </div>

        {% include '_map_picker.html.twig' with {
            mapId: 'siteMap',
            latFieldId: 'site_lat',
            lngFieldId: 'site_lng'
        } %}

        <button type="submit" class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}