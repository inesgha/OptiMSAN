{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Shelf {{ shelf.numeroShelf }}{% endblock %}

{% block content %}
    <div class="om-narrow">
        {% set actions %}
            <a href="{{ path('app_shelf_edit', {'id': shelf.id}) }}" class="btn btn-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Modifier</a>
        {% endset %}
        {{ ui.page_header('Shelf n°' ~ shelf.numeroShelf, {
            back_url: path('app_shelf_index'),
            back_label: 'Shelves',
            eyebrow: 'Shelf',
            icon: 'hdd-rack',
            actions: actions,
        }) }}

        <section class="om-card">
            <div class="om-card__body">
                <dl class="om-dl">
                    <dt>Identifiant</dt><dd><code>{{ shelf.id }}</code></dd>
                    <dt>Numéro de shelf</dt><dd>{{ shelf.numeroShelf }}</dd>
                    <dt>Adresse IP (sous-réseau)</dt><dd><code>{{ shelf.adresseIpSub }}</code></dd>
                    <dt>Site MSAN</dt>
                    <dd>
                        {% if shelf.siteMSAN %}
                            <a href="{{ path('app_site_m_s_a_n_show', {'id': shelf.siteMSAN.id}) }}">{{ shelf.siteMSAN.nomSite }}</a>
                        {% else %}—{% endif %}
                    </dd>
                </dl>
            </div>
        </section>

        {{ include('shelf/_delete_form.html.twig') }}
    </div>
{% endblock %}
