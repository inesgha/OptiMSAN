<form method="post" action="{{ path('app_slot_card_delete', {'id': slot_card.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette SlotCard ?');" class="mt-3">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ slot_card.id) }}">
    <button class="btn btn-outline-danger btn-sm">Supprimer cette SlotCard</button>
</form>