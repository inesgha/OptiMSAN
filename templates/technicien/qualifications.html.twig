{% extends 'layout/technicien.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Mes qualifications de ligne{% endblock %}

{% block content %}
    {% set actions %}
        <a href="{{ path('technicien_qualification_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nouveau test</a>
    {% endset %}
    {{ ui.page_header('Qualification de ligne', {
        eyebrow: 'Terrain',
        icon: 'activity',
        subtitle: 'Historique de vos tests xDSL : mesures relevées et débit estimé selon la distance au site.',
        actions: actions,
    }) }}

    <section class="om-card" data-controller="table-filter" aria-label="Mes tests de ligne">
        {% if qualifications is empty %}
            {{ ui.empty_state('Aucun test réalisé pour le moment', 'Qualifiez une ligne pour estimer son débit à partir de vos mesures.', 'activity', path('technicien_qualification_new'), 'Nouveau test') }}
        {% else %}
            {{ ui.toolbar('Rechercher un port, un standard…', {'excellente': 'Excellente', 'bonne': 'Bonne', 'moyenne': 'Moyenne', 'faible': 'Faible'}, 'Filtrer par qualité') }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Port</th>
                            <th scope="col">Standard</th>
                            <th scope="col" class="om-col-num">Débit estimé ↓ / ↑</th>
                            <th scope="col" class="om-col-num">Distance</th>
                            <th scope="col">Qualité</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for qualification in qualifications %}
                            <tr data-table-filter-target="row" data-etat="{{ qualification.qualiteGlobale }}">
                                <td class="om-mono text-nowrap">{{ qualification.dateTest|date('d/m/Y H:i') }}</td>
                                <td>Port {{ qualification.portMSAN ? qualification.portMSAN.numeroPort : '—' }}</td>
                                <td><span class="om-tag">{{ qualification.standard }}</span></td>
                                <td class="om-col-num om-mono text-nowrap">{{ qualification.channelRateDown }} / {{ qualification.channelRateUp }} <span class="om-muted">kbps</span></td>
                                <td class="om-col-num om-mono text-nowrap">{{ qualification.distanceKm }} km</td>
                                <td>{{ ui.badge('qualite', qualification.qualiteGlobale) }}</td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(6) }}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
