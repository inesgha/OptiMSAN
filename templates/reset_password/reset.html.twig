{% extends 'layout/auth.html.twig' %}

{% block title %}Nouveau mot de passe — OptiMSAN{% endblock %}

{% block auth %}
    <h1 class="om-auth__title">Nouveau mot de passe</h1>
    <p class="om-auth__intro">Choisissez un nouveau mot de passe pour votre compte.</p>

    {{ form_start(resetForm) }}
        {{ form_errors(resetForm) }}
        {{ form_errors(resetForm.plainPassword) }}
        {{ form_row(resetForm.plainPassword.first, {'label': 'Nouveau mot de passe', 'help': 'Au moins 12 caractères, difficile à deviner.'}) }}
        {{ form_row(resetForm.plainPassword.second, {'label': 'Confirmez le mot de passe'}) }}

        <button class="btn btn-primary btn-lg w-100" type="submit">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>Réinitialiser le mot de passe
        </button>
    {{ form_end(resetForm) }}
{% endblock %}
