{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Dashboard de saturation{% endblock %}

{% block content %}
    {{ ui.page_header('Saturation du réseau', {
        eyebrow: 'Pilotage',
        icon: 'speedometer2',
        subtitle: 'Taux d\'occupation des ports MSAN, site par site.',
    }) }}

    {% set totalLibres = 0 %}
    {% set totalPanne = 0 %}
    {% for site in sites %}
        {% set totalLibres = totalLibres + site.ports_libres %}
        {% set totalPanne = totalPanne + site.ports_en_panne %}
    {% endfor %}

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <section class="om-card h-100" aria-labelledby="titre-global">
                <div class="om-card__header">
                    <h2 class="om-card__title" id="titre-global"><i class="bi bi-pie-chart" aria-hidden="true"></i>Taux de saturation global</h2>
                </div>
                <div class="om-card__body d-flex flex-column align-items-center gap-4">
                    {{ ui.gauge(tauxGlobal, 'des ports occupés') }}
                    <dl class="om-dl w-100">
                        <dt>Ports totaux</dt><dd class="om-mono text-end">{{ totalPorts }}</dd>
                        <dt>Ports occupés</dt><dd class="om-mono text-end">{{ totalOccupes }}</dd>
                        <dt>Ports libres</dt><dd class="om-mono text-end">{{ totalLibres }}</dd>
                        <dt>Ports en panne</dt><dd class="om-mono text-end">{{ totalPanne }}</dd>
                    </dl>
                    <div class="om-legend">
                        <span class="om-legend__item"><span class="om-legend__swatch om-legend__swatch--success"></span>&lt; 70 %</span>
                        <span class="om-legend__item"><span class="om-legend__swatch om-legend__swatch--warning"></span>70 à 90 %</span>
                        <span class="om-legend__item"><span class="om-legend__swatch om-legend__swatch--danger"></span>≥ 90 %</span>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-lg-8">
            <section class="om-card h-100" aria-labelledby="titre-graphique">
                <div class="om-card__header">
                    <div>
                        <h2 class="om-card__title" id="titre-graphique"><i class="bi bi-bar-chart" aria-hidden="true"></i>Ports par site</h2>
                        <p class="om-card__subtitle">Occupés, libres et en panne</p>
                    </div>
                </div>
                <div class="om-card__body">
                    {% if sites is empty %}
                        {{ ui.empty_state('Aucun site enregistré', 'Ajoutez des sites MSAN pour suivre leur saturation.', 'building', path('app_site_m_s_a_n_new'), 'Ajouter un site') }}
                    {% else %}
                        <div style="position: relative; height: 300px;">
                            <canvas id="saturationChart" role="img" aria-label="Graphique des ports occupés, libres et en panne par site MSAN"></canvas>
                        </div>
                    {% endif %}
                </div>
            </section>
        </div>
    </div>

    {% if sites is not empty %}
        <section class="om-card" data-controller="table-filter" aria-label="Saturation par site">
            {{ ui.toolbar('Rechercher un site…', {'ok': 'Normal (< 70 %)', 'warn': 'Élevé (70 à 90 %)', 'crit': 'Critique (≥ 90 %)'}, 'Filtrer par niveau de saturation') }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Site MSAN</th>
                            <th scope="col">Type</th>
                            <th scope="col" class="om-col-num">Total</th>
                            <th scope="col" class="om-col-num">Occupés</th>
                            <th scope="col" class="om-col-num">Libres</th>
                            <th scope="col" class="om-col-num">En panne</th>
                            <th scope="col" style="min-width: 220px;">Taux de saturation</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for site in sites %}
                            {% set taux = site.total_ports > 0 ? (site.ports_occupes / site.total_ports * 100)|round(1) : 0 %}
                            <tr data-table-filter-target="row" data-etat="{{ ui.niveau(taux)|trim }}">
                                <td class="om-cell-main">{{ site.nom_site }}</td>
                                <td><span class="om-tag">{{ site.type_msan }}</span></td>
                                <td class="om-col-num">{{ site.total_ports }}</td>
                                <td class="om-col-num">{{ site.ports_occupes }}</td>
                                <td class="om-col-num">{{ site.ports_libres }}</td>
                                <td class="om-col-num">{{ site.ports_en_panne }}</td>
                                <td>{{ ui.meter(taux, 'Saturation du site ' ~ site.nom_site) }}</td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(7) }}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% if sites is not empty %}
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            Chart.defaults.font.family = "'IBM Plex Sans', system-ui, sans-serif";
            Chart.defaults.color = '#526075';

            new Chart(document.getElementById('saturationChart'), {
                type: 'bar',
                data: {
                    labels: {{ sites|map(s => s.nom_site)|json_encode|raw }},
                    datasets: [
                        { label: 'Ports occupés', data: {{ sites|map(s => s.ports_occupes|default(0) + 0)|json_encode|raw }}, backgroundColor: '#3B82F6', borderRadius: 4 },
                        { label: 'Ports libres', data: {{ sites|map(s => s.ports_libres|default(0) + 0)|json_encode|raw }}, backgroundColor: '#22C55E', borderRadius: 4 },
                        { label: 'Ports en panne', data: {{ sites|map(s => s.ports_en_panne|default(0) + 0)|json_encode|raw }}, backgroundColor: '#EF4444', borderRadius: 4 },
                    ],
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } },
                    scales: {
                        x: { stacked: true, grid: { display: false } },
                        y: { stacked: true, beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#EEF2F6' } },
                    },
                },
            });
        </script>
    {% endif %}
{% endblock %}
