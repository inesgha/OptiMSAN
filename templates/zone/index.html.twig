{% extends 'base.html.twig' %}

{% block title %}Zones{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('admin_dashboard') }}">← OptiMSAN Admin</a>
</nav>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Zones</h1>
        <a href="{{ path('app_zone_new') }}" class="btn btn-primary">+ Ajouter une zone</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nom de la zone</th>
                <th>Code postal</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for zone in zones %}
            <tr>
                <td><code>{{ zone.id }}</code></td>
                <td>{{ zone.nomZone }}</td>
                <td>{{ zone.codePostal }}</td>
                <td>
                    <a href="{{ path('app_zone_show', {'id': zone.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                    <a href="{{ path('app_zone_edit', {'id': zone.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center text-muted py-4">Aucune zone enregistrée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}