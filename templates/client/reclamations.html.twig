{% extends 'layout/client.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Mes réclamations{% endblock %}

{% block content %}
    {% set actions %}
        <a href="{{ path('client_reclamation_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nouvelle réclamation</a>
    {% endset %}
    {{ ui.page_header('Mes réclamations', {
        eyebrow: 'Mon espace',
        icon: 'ticket-detailed',
        subtitle: 'Chaque réclamation suit les étapes : ouvert → en cours → résolu → fermé.',
        actions: actions,
    }) }}

    {% if reclamations is empty %}
        <section class="om-card">
            {{ ui.empty_state('Aucune réclamation pour le moment', 'En cas de panne sur votre ligne, signalez-la : un ticket sera créé et suivi par nos équipes.', 'ticket-detailed', path('client_reclamation_new'), 'Signaler une panne') }}
        </section>
    {% else %}
        <div data-controller="table-filter">
            <div class="om-card mb-3">
                {{ ui.toolbar('Rechercher un ticket, un type de panne…', constant('App\\Service\\ReclamationWorkflow::LIBELLES')) }}
            </div>

            {% for reclamation in reclamations|sort((a, b) => b.dateCreation <=> a.dateCreation) %}
                <article class="om-card mb-3" data-table-filter-target="row" data-etat="{{ reclamation.etatTicket }}" aria-labelledby="ticket-{{ reclamation.id }}">
                    <div class="om-card__header">
                        <div>
                            <h2 class="om-card__title" id="ticket-{{ reclamation.id }}"><code>{{ reclamation.codeTicket }}</code></h2>
                            <p class="om-card__subtitle">Déposée le {{ reclamation.dateCreation ? reclamation.dateCreation|date('d/m/Y à H:i') }}</p>
                        </div>
                        <div class="d-flex gap-2">
                            {{ ui.badge('priorite', reclamation.priorite) }}
                            {{ ui.badge('ticket', reclamation.etatTicket) }}
                        </div>
                    </div>
                    <div class="om-card__body">
                        <div class="row g-4 align-items-center">
                            <div class="col-lg-5">
                                <p class="om-cell-main mb-1">{{ reclamation.typePanne|libelle('panne') }}</p>
                                <p class="om-muted om-small mb-0">{{ reclamation.description ?: 'Aucune description' }}</p>
                            </div>
                            <div class="col-lg-7">{{ ui.frise_ticket(reclamation, true) }}</div>
                        </div>
                    </div>
                </article>
            {% endfor %}

            <div class="om-card" data-table-filter-target="empty" hidden>
                <p class="om-card__body text-center om-muted mb-0">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>Aucune réclamation ne correspond à votre recherche.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-action="table-filter#reset">Réinitialiser</button>
                </p>
            </div>
        </div>
    {% endif %}
{% endblock %}
