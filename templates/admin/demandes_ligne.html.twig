{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Demandes de ligne{% endblock %}

{% block content %}
    {{ ui.page_header('Demandes de ligne', {
        eyebrow: 'Exploitation',
        icon: 'telephone-plus',
        subtitle: 'Validez les demandes d\'installation et affectez un port MSAN libre.',
    }) }}

    <section class="om-card" data-controller="table-filter" aria-label="Liste des demandes de ligne">
        {% if demandes is empty %}
            {{ ui.empty_state('Aucune demande pour le moment', 'Les demandes de nouvelle ligne déposées par les clients apparaîtront ici.', 'telephone-plus') }}
        {% else %}
            {{ ui.toolbar('Rechercher une référence, un client, une adresse…', constant('App\\Service\\DemandeLigneWorkflow::LIBELLES')) }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Référence</th>
                            <th scope="col">Client</th>
                            <th scope="col">Offre</th>
                            <th scope="col">Adresse d'installation</th>
                            <th scope="col">Port affecté</th>
                            <th scope="col">État</th>
                            <th scope="col" class="om-col-actions"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for demande in demandes %}
                            <tr data-table-filter-target="row" data-etat="{{ demande.etatDemande }}">
                                <td>
                                    <code>{{ demande.codeDemande }}</code>
                                    <span class="om-cell-sub">{{ demande.dateDemande ? demande.dateDemande|date('d/m/Y H:i') }}</span>
                                </td>
                                <td class="text-nowrap">{{ ui.personne(demande.client) }}</td>
                                <td class="text-nowrap">{{ demande.typeOffre|libelle('offre') }}</td>
                                <td><span class="om-truncate" title="{{ demande.adresseInstallation }}">{{ demande.adresseInstallation }}</span></td>
                                <td class="text-nowrap">
                                    {% if demande.portMSAN %}
                                        <i class="bi bi-ethernet om-muted me-1" aria-hidden="true"></i>Port {{ demande.portMSAN.numeroPort }}
                                    {% else %}
                                        <span class="om-muted">Non affecté</span>
                                    {% endif %}
                                </td>
                                <td>{{ ui.badge('demande', demande.etatDemande) }}</td>
                                <td class="om-col-actions">
                                    <a href="{{ path('admin_demande_ligne_assign', {'id': demande.id}) }}" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-sliders" aria-hidden="true"></i>Gérer<span class="visually-hidden"> la demande {{ demande.codeDemande }}</span>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(7) }}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
