{% extends 'layout/admin.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Sites MSAN{% endblock %}

{% block content %}
    {% set actions %}
        <a href="{{ path('app_site_m_s_a_n_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Ajouter un site</a>
    {% endset %}
    {{ ui.page_header('Sites MSAN', {
        eyebrow: 'Inventaire réseau',
        icon: 'building',
        subtitle: 'Sites hébergeant les équipements MSAN, localisés sur la carte.',
        actions: actions,
    }) }}
    {{ ui.hierarchie('site') }}

    <section class="om-card" data-controller="table-filter" aria-label="Liste des sites MSAN">
        {% if site_m_s_a_ns is empty %}
            {{ ui.empty_state('Aucun site MSAN enregistré', 'Ajoutez un site et placez-le sur la carte.', 'building', path('app_site_m_s_a_n_new'), 'Ajouter un site') }}
        {% else %}
            {{ ui.toolbar('Rechercher un site, une IP, un constructeur…') }}
            <div class="table-responsive">
                <table class="table om-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Site</th>
                            <th scope="col">Adresse IP</th>
                            <th scope="col">Type</th>
                            <th scope="col">Constructeur</th>
                            <th scope="col">Coordonnées</th>
                            <th scope="col" class="om-col-actions"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for siteMsan in site_m_s_a_ns %}
                            <tr data-table-filter-target="row">
                                <td>
                                    <span class="om-cell-main">{{ siteMsan.nomSite }}</span>
                                    <span class="om-cell-sub"><i class="bi bi-map me-1" aria-hidden="true"></i>{{ siteMsan.zone ? siteMsan.zone.nomZone : 'Sans zone' }}</span>
                                </td>
                                <td><code>{{ siteMsan.adresseIp }}</code></td>
                                <td><span class="om-tag">{{ siteMsan.typeMSAN }}</span></td>
                                <td>{{ siteMsan.constructeur }}</td>
                                <td class="om-mono om-small text-nowrap">{{ siteMsan.latitude|number_format(4, '.') }}, {{ siteMsan.longitude|number_format(4, '.') }}</td>
                                <td class="om-col-actions">
                                    <a href="{{ path('app_site_m_s_a_n_show', {'id': siteMsan.id}) }}" class="btn btn-ghost btn-sm"><i class="bi bi-eye" aria-hidden="true"></i>Voir<span class="visually-hidden"> le site {{ siteMsan.nomSite }}</span></a>
                                    <a href="{{ path('app_site_m_s_a_n_edit', {'id': siteMsan.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil" aria-hidden="true"></i>Modifier<span class="visually-hidden"> le site {{ siteMsan.nomSite }}</span></a>
                                </td>
                            </tr>
                        {% endfor %}
                        {{ ui.aucun_resultat(6) }}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
