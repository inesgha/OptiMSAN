{% extends 'base.html.twig' %}

{% block title %}Tester la ligne — {{ demande.codeDemande }}{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('admin_demande_ligne_assign', {'id': demande.id}) }}">← Retour à la demande</a>
</nav>

<div class="container mt-4" style="max-width: 700px;">
    <h1 class="mb-4">Test technique — {{ demande.codeDemande }}</h1>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row">
            <div class="col-md-6 mb-3">{{ form_label(form.technicien) }}{{ form_widget(form.technicien, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.technicien) }}</div>
            <div class="col-md-6 mb-3">{{ form_label(form.portMSAN) }}{{ form_widget(form.portMSAN, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.portMSAN) }}</div>
        </div>
        <div class="mb-3">{{ form_label(form.standard) }}{{ form_widget(form.standard, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.standard) }}</div>
        <div class="row">
            <div class="col-md-6 mb-3">{{ form_label(form.channelRateDown) }}{{ form_widget(form.channelRateDown, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.channelRateDown) }}</div>
            <div class="col-md-6 mb-3">{{ form_label(form.channelRateUp) }}{{ form_widget(form.channelRateUp, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.channelRateUp) }}</div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">{{ form_label(form.snrMarginDown) }}{{ form_widget(form.snrMarginDown, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.snrMarginDown) }}</div>
            <div class="col-md-6 mb-3">{{ form_label(form.snrMarginUp) }}{{ form_widget(form.snrMarginUp, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.snrMarginUp) }}</div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">{{ form_label(form.attenuationDown) }}{{ form_widget(form.attenuationDown, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.attenuationDown) }}</div>
            <div class="col-md-6 mb-3">{{ form_label(form.attenuationUp) }}{{ form_widget(form.attenuationUp, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.attenuationUp) }}</div>
        </div>
        <div class="mb-3">{{ form_label(form.distanceKm) }}{{ form_widget(form.distanceKm, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.distanceKm) }}</div>
        <div class="mb-3">{{ form_label(form.qualiteGlobale) }}{{ form_widget(form.qualiteGlobale, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.qualiteGlobale) }}</div>

        <button type="submit" class="btn btn-primary">Enregistrer le test</button>
    {{ form_end(form) }}
</div>
{% endblock %}