{% extends 'base.html.twig' %}

{% block title %}Demande de ligne{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand" href="{{ path('client_dashboard') }}">← OptiMSAN Client</a>
</nav>

<div class="container mt-4" style="max-width: 700px;">
    <h1 class="mb-4">Demander une nouvelle ligne</h1>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="mb-3">
            {{ form_label(form.typeOffre) }}
            {{ form_widget(form.typeOffre, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.typeOffre) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.adresseInstallation) }}
            {{ form_widget(form.adresseInstallation, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.adresseInstallation) }}
        </div>
        {{ form_widget(form.latitude, {'id': 'demande_lat'}) }}{{ form_errors(form.latitude) }}
{{ form_widget(form.longitude, {'id': 'demande_lng'}) }}{{ form_errors(form.longitude) }}

{% include '_map_picker.html.twig' with {
    mapId: 'demandeMap',
    latFieldId: 'demande_lat',
    lngFieldId: 'demande_lng'
} %}

        <button type="submit" class="btn btn-primary">Envoyer la demande</button>
    {{ form_end(form) }}
</div>
{% endblock %}