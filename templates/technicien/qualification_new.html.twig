{% extends 'base.html.twig' %}

{% block title %}Qualifier une ligne{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-warning px-3">
    <a class="navbar-brand text-dark" href="{{ path('technicien_dashboard') }}">← OptiMSAN Technicien</a>
</nav>

<div class="container mt-4" style="max-width: 700px;">
    <h1 class="mb-4">Qualifier une ligne xDSL</h1>

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}

    <div class="alert alert-info">
        ℹ️ La distance et le débit seront calculés automatiquement à l'enregistrement, en fonction de votre position et du standard sélectionné.
    </div>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="mb-3">{{ form_label(form.portMSAN) }}{{ form_widget(form.portMSAN, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.portMSAN) }}</div>
        <div class="mb-3">{{ form_label(form.standard) }}{{ form_widget(form.standard, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.standard) }}</div>
        <div class="row">
            <div class="col-md-6 mb-3">{{ form_label(form.snrMarginDown) }}{{ form_widget(form.snrMarginDown, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.snrMarginDown) }}</div>
            <div class="col-md-6 mb-3">{{ form_label(form.snrMarginUp) }}{{ form_widget(form.snrMarginUp, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.snrMarginUp) }}</div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">{{ form_label(form.attenuationDown) }}{{ form_widget(form.attenuationDown, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.attenuationDown) }}</div>
            <div class="col-md-6 mb-3">{{ form_label(form.attenuationUp) }}{{ form_widget(form.attenuationUp, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.attenuationUp) }}</div>
        </div>
        <div class="mb-3">{{ form_label(form.qualiteGlobale) }}{{ form_widget(form.qualiteGlobale, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.qualiteGlobale) }}</div>

        <button type="submit" class="btn btn-primary">Enregistrer le test</button>
    {{ form_end(form) }}
</div>
{% endblock %}