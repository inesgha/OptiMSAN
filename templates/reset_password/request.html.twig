{% extends 'layout/auth.html.twig' %}

{% block title %}Mot de passe oublié — OptiMSAN{% endblock %}

{% block auth %}
    <a class="om-back" href="{{ path('app_login') }}"><i class="bi bi-arrow-left" aria-hidden="true"></i>Retour à la connexion</a>
    <h1 class="om-auth__title">Mot de passe oublié</h1>
    <p class="om-auth__intro">
        Indiquez votre adresse e-mail : nous vous enverrons un lien
        pour réinitialiser votre mot de passe.
    </p>

    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email, {'label': 'Adresse e-mail', 'attr': {'placeholder': 'prenom.nom@exemple.tn'}}) }}

        <button class="btn btn-primary btn-lg w-100" type="submit">
            <i class="bi bi-envelope" aria-hidden="true"></i>Envoyer le lien
        </button>
    {{ form_end(requestForm) }}
{% endblock %}
