{{ form_start(form) }}
    <section class="om-card">
        <div class="om-card__body">
            {{ form_errors(form) }}
            {{ form_row(form.shelf, {'label': 'Shelf'}) }}
            <div class="row gx-3">
                <div class="col-md-4">{{ form_row(form.numeroSlot, {'label': 'Numéro de slot', 'attr': {'min': 0}}) }}</div>
                <div class="col-md-4">{{ form_row(form.typeCarte, {'label': 'Type de carte', 'attr': {'placeholder': 'Ex. VDSL2'}}) }}</div>
                <div class="col-md-4">{{ form_row(form.nombrePortsTotal, {'label': 'Nombre de ports', 'help': 'Entre 1 et 128', 'attr': {'min': 1, 'max': 128}}) }}</div>
            </div>
        </div>
        <div class="om-card__footer">
            <a href="{{ path('app_slot_card_index') }}" class="btn btn-outline-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>{{ button_label|default('Enregistrer') }}</button>
        </div>
    </section>
{{ form_end(form) }}
