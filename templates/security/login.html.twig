{% extends 'layout/auth.html.twig' %}

{% block title %}Connexion — OptiMSAN{% endblock %}

{% block auth %}
    <h1 class="om-auth__title">Connexion</h1>
    <p class="om-auth__intro">Accédez à votre espace OptiMSAN.</p>

    {% if error %}
        <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
            <i class="bi bi-exclamation-octagon-fill mt-1" aria-hidden="true"></i>
            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
    {% endif %}

    {% if app.user %}
        {% set espace = is_granted('ROLE_ADMIN') ? 'admin_dashboard' : (is_granted('ROLE_TECHNICIEN') ? 'technicien_dashboard' : 'client_dashboard') %}
        <div class="alert alert-info" role="status">
            Vous êtes déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
            <a href="{{ path(espace) }}" class="alert-link">Accéder à mon espace</a>
            ou <a href="{{ logout_path() }}" class="alert-link">se déconnecter</a>.
        </div>
    {% endif %}

    <form method="post">
        <div class="mb-3">
            <label for="inputEmail" class="form-label">Adresse e-mail</label>
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                   class="form-control" autocomplete="email" placeholder="prenom.nom@exemple.tn" required autofocus>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-baseline">
                <label for="inputPassword" class="form-label">Mot de passe</label>
                <a href="{{ path('app_forgot_password_request') }}" class="om-small">Mot de passe oublié ?</a>
            </div>
            <input type="password" name="password" id="inputPassword"
                   class="form-control" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <div class="form-check mb-4">
            <input type="checkbox" name="_remember_me" class="form-check-input" id="rememberMe">
            <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
        </div>

        <button class="btn btn-primary btn-lg w-100" type="submit">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Se connecter
        </button>
    </form>

    <div class="om-divider">Nouveau client ?</div>
    <a href="{{ path('app_register') }}" class="btn btn-outline-secondary w-100">
        <i class="bi bi-person-plus" aria-hidden="true"></i>Créer un compte client
    </a>
{% endblock %}
