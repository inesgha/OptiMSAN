{% extends 'layout/technicien.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% block title %}Ma position{% endblock %}

{% block content %}
    <div class="om-narrow">
        {{ ui.page_header('Ma position GPS', {
            eyebrow: 'Terrain',
            icon: 'crosshair',
            subtitle: 'Elle sert à afficher les pannes à proximité (15 km) et à calculer la distance lors d\'une qualification de ligne.',
        }) }}

        {{ form_start(form) }}
            <section class="om-card">
                <div class="om-card__body">
                    {{ form_errors(form) }}
                    <div class="row gx-3">
                        <div class="col-sm-6">{{ form_row(form.latitudeActuelle, {'attr': {'class': 'om-mono', 'inputmode': 'decimal'}}) }}</div>
                        <div class="col-sm-6">{{ form_row(form.longitudeActuelle, {'attr': {'class': 'om-mono', 'inputmode': 'decimal'}}) }}</div>
                    </div>

                    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="btn-geoloc">
                        <i class="bi bi-crosshair" aria-hidden="true"></i>Utiliser ma position actuelle
                    </button>
                    <p class="om-small text-danger d-none" id="geoloc-erreur" role="alert"></p>

                    {% include '_map_picker.html.twig' with {
                        mapId: 'positionMap',
                        latFieldId: form.latitudeActuelle.vars.id,
                        lngFieldId: form.longitudeActuelle.vars.id,
                        label: 'Ou placez-vous sur la carte'
                    } %}
                </div>
                <div class="om-card__footer">
                    <a href="{{ path('technicien_dashboard') }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Enregistrer</button>
                </div>
            </section>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
<script>
    document.getElementById('btn-geoloc').addEventListener('click', function () {
        const erreur = document.getElementById('geoloc-erreur');
        if (!navigator.geolocation) {
            erreur.textContent = 'La géolocalisation n\'est pas disponible dans ce navigateur.';
            erreur.classList.remove('d-none');
            return;
        }
        navigator.geolocation.getCurrentPosition(function (pos) {
            const lat = document.querySelector('[name="technicien_position[latitudeActuelle]"]');
            const lng = document.querySelector('[name="technicien_position[longitudeActuelle]"]');
            lat.value = pos.coords.latitude.toFixed(6);
            lng.value = pos.coords.longitude.toFixed(6);
            erreur.classList.add('d-none');
            lat.dispatchEvent(new Event('change'));
        }, function () {
            erreur.textContent = 'Impossible d\'obtenir votre position : autorisez la géolocalisation dans le navigateur.';
            erreur.classList.remove('d-none');
        });
    });
</script>
{% endblock %}
