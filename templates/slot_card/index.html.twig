{% extends 'base.html.twig' %}

{% block title %}SlotCards{% endblock %}

{% block body %}
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('admin_dashboard') }}">← OptiMSAN Admin</a>
</nav>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>SlotCards</h1>
        <a href="{{ path('app_slot_card_new') }}" class="btn btn-primary">+ Ajouter une SlotCard</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Numéro Slot</th>
                <th>Type de carte</th>
                <th>Nombre de ports</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for slot_card in slot_cards %}
            <tr>
                <td><code>{{ slot_card.id }}</code></td>
                <td>{{ slot_card.numeroSlot }}</td>
                <td><span class="badge bg-info text-dark">{{ slot_card.typeCarte }}</span></td>
                <td>{{ slot_card.nombrePortsTotal }}</td>
                <td>
                    <a href="{{ path('app_slot_card_show', {'id': slot_card.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                    <a href="{{ path('app_slot_card_edit', {'id': slot_card.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">Aucune SlotCard enregistrée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}