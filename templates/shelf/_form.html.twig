{{ form_start(form) }}
    <section class="om-card">
        <div class="om-card__body">
            {{ form_errors(form) }}
            {{ form_row(form.sitemsan, {'label': 'Site MSAN'}) }}
            <div class="row gx-3">
                <div class="col-md-4">{{ form_row(form.numeroShelf, {'label': 'Numéro de shelf', 'attr': {'min': 0}}) }}</div>
                <div class="col-md-8">{{ form_row(form.adresseIpSub, {'label': 'Adresse IP (sous-réseau)', 'attr': {'class': 'om-mono', 'placeholder': '10.0.1.1'}}) }}</div>
            </div>
        </div>
        <div class="om-card__footer">
            <a href="{{ path('app_shelf_index') }}" class="btn btn-outline-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>{{ button_label|default('Enregistrer') }}</button>
        </div>
    </section>
{{ form_end(form) }}
